# TaskFlow — Environment Variables
# Copy this file to `.env` and adjust the values if needed:
#   cp .env.example .env
#
# Developed by Brijesh Mishra

# SQLite database location (relative to the prisma/schema.prisma file)
DATABASE_URL=file:../db/custom.db

# Secret used to sign JWT session tokens.
# IMPORTANT: replace this with a long random string in production!
JWT_SECRET=change-me-to-a-long-random-secret-string
